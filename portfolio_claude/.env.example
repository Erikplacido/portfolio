# Copie para .env.local (nunca commite). Na Vercel, cadastre em
# Project → Settings → Environment Variables. Passo a passo: CHAT-TELEGRAM.md

# --- Telegram ---
TELEGRAM_BOT_TOKEN=        # o @BotFather entrega ao criar o bot
TELEGRAM_CHAT_ID=          # id do grupo "Chat Site" (número negativo); node dev/telegram-setup.mjs mostra
TELEGRAM_WEBHOOK_SECRET=   # texto aleatório (16+ letras/números); gere com: openssl rand -hex 24

# --- Upstash Redis (a integração da Vercel cria estas sozinha) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- limites ---
# CHAT_MAX_PER_HOUR=60     # teto de mensagens de visitantes por hora, somando todos

# --- só no teste local: memória no lugar do Redis e console no lugar do Telegram ---
# CHAT_MOCK=1
